---
import PageLayout from '../../layouts/PageLayout.astro';
import { excerpt, formatDate, getPosts, postUrl } from '../../lib/posts';

const posts = await getPosts();
---

<PageLayout title="お知らせ" eyebrow="News">
  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <a href={postUrl(post)} class="post-item">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span class="post-title">{post.data.title}</span>
            <span class="post-excerpt">{excerpt(post.body, 120)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .post-list {
    display: grid;
    gap: 12px;
    max-width: 860px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-item {
    display: grid;
    grid-template-columns: 9em minmax(0, 1fr);
    gap: 4px 24px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 3%);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .post-item:hover {
    background: var(--surface);
  }

  .post-item time {
    grid-row: span 2;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .post-title {
    font-weight: 700;
    line-height: 1.5;
  }

  .post-excerpt {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .post-item {
      grid-template-columns: minmax(0, 1fr);
      padding: 18px;
    }

    .post-item time {
      grid-row: auto;
    }
  }
</style>
